{
  "name": "temponotaquari",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "tsx server.ts",
    "dev": "concurrently -k \"npm:dev:server\" \"vite\"",
